model OperationalZone {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  zoneCode           String              @db.VarChar(40)
  name               String              @db.VarChar(160)
  zoneType           OperationalZoneType
  description        String?             @db.VarChar(500)
