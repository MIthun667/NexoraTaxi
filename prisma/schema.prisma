  @@index([organizationId, status, severity, reportedAt])
  @@index([zoneId, status, reportedAt])
  @@index([workOrderId])
  @@index([workforceMemberId])
  @@index([assetId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([assignedToUserId, status])
  @@map("operational_incidents")
}

