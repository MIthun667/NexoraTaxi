model OperationalIncident {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  incidentCode      String                    @db.VarChar(40)
  incidentType      String                    @db.VarChar(80)
  title             String                    @db.VarChar(160)
  description       String?                   @db.VarChar(1000)
  severity          IncidentSeverity
  status            OperationalIncidentStatus @default(OPEN)
  zoneId            String?                   @db.Uuid
  workOrderId       String?                   @db.Uuid
  workforceMemberId String?                   @db.Uuid
  assetId           String?                   @db.Uuid
  relatedEntityType String?                   @db.VarChar(80)
  relatedEntityId   String?                   @db.VarChar(100)
  reportedByUserId  String?                   @db.Uuid
  assignedToUserId  String?                   @db.Uuid
  reportedAt        DateTime                  @default(now())
  resolvedAt        DateTime?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  zone              OperationalZone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  workOrder         WorkOrder?                @relation(fields: [workOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  workforceMember   WorkforceMember?          @relation(fields: [workforceMemberId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset             Asset?                    @relation(fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportedByUser    User?                     @relation("OperationalIncidentReportedByUser", fields: [reportedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedToUser    User?                     @relation("OperationalIncidentAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
