  status              OrganizationStatus        @default(ACTIVE)
  lifecycleStatus     OrganizationLifecycleStatus @default(PROSPECT)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  departments         Department[]
  positions           Position[]
  employees           Employee[]
  users               User[]
  workflowInstances   WorkflowInstance[]
  approvalRequests    ApprovalRequest[]
  drivers             Driver[]
  fleetVehicles       FleetVehicle[]
  dispatchZones       DispatchZone[]
  dispatchShifts      DispatchShift[]
  dispatchAssignments DriverVehicleAssignment[]
  dispatchRuns        DispatchRun[]
  dispatchIncidents   DispatchIncident[]
  domainEvents        DomainEvent[]
  notifications       Notification[]
  inferenceAuditLogs  InferenceAuditLog[]
  agentRuns           AgentRun[]
  agentExecutionMetrics AgentExecutionMetric[]
  agentPolicyViolations AgentPolicyViolation[]
  agentOperationalImpacts AgentOperationalImpact[]
  decisionReports     DecisionReport[]
  agentTriggerEvents  AgentTriggerEvent[]
  subscriptions       OrganizationSubscription[]
  usageRecords        OrganizationUsage[]
  billingEvents       OrganizationBillingEvent[]
  systemAlerts        SystemAlert[]
  healthCheckLogs     HealthCheckLog[]
  connectorInstances  ConnectorInstance[]
  connectorActionLogs ConnectorActionLog[]
  integrationShopifyStores IntegrationShopifyStore[]
  integrationStripeAccounts IntegrationStripeAccount[]
  shopifyOrders       ShopifyOrder[]
  shopifyProducts     ShopifyProduct[]
  shopifyCustomers    ShopifyCustomer[]
  shopifySyncRuns     ShopifySyncRun[]
  shopifyWebhookDeliveries ShopifyWebhookDelivery[]
  shopifySyncCursors  ShopifySyncCursor[]
  stripeCharges      StripeCharge[]
  stripePaymentEvents StripePaymentEvent[]
  stripeSyncRuns     StripeSyncRun[]
  crmCustomerProfiles CrmCustomerProfile[]
  crmCustomerSegmentSnapshots CrmCustomerSegmentSnapshot[]
  aiSignals          AiSignal[]
  aiInsights         AiInsight[]
  aiDailySummaries   AiDailySummary[]
