model ActionOutcome {
  id                String               @id @default(uuid()) @db.Uuid
  executionId       String               @unique @db.Uuid
  proposalId        String?              @db.Uuid
  recommendationId  String?              @db.Uuid
  organizationId    String               @db.Uuid
  outcomeType       ActionOutcomeType    @default(UNKNOWN)
  outcomeScore      Float                @default(0)
  impactMetrics     Json?
  notes             String?              @db.VarChar(1000)
  recordedAt        DateTime             @default(now())
  execution         ActionExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([proposalId])
  @@index([recommendationId])
  @@map("action_outcomes")
}

model DecisionLog {
  id             String         @id @default(uuid()) @db.Uuid
  proposalId     String         @db.Uuid
  organizationId String         @db.Uuid
  decision       String         @db.VarChar(40)
  decidedByUserId String?        @db.Uuid
  decidedAt      DateTime       @default(now())
  reason         String?        @db.VarChar(1000)
  metadata       Json?
  proposal       ActionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedByUser  User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId])
  @@index([proposalId])
  @@map("decision_logs")
}

