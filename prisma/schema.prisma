model WorkforceMember {
  id                  String                      @id @default(uuid()) @db.Uuid
  organizationId      String                      @db.Uuid
  employeeId          String?                     @unique @db.Uuid
  userId              String?                     @unique @db.Uuid
  workerCode          String                      @db.VarChar(40)
  workerType          WorkforceMemberType
  employmentModel     WorkforceEmploymentModel?
  firstName           String                      @db.VarChar(100)
  lastName            String                      @db.VarChar(100)
  displayName         String?                     @db.VarChar(200)
  workEmail           String?                     @db.VarChar(255)
  phoneNumber         String?                     @db.VarChar(30)
  operationalStatus   WorkforceOperationalStatus  @default(ACTIVE)
  complianceStatus    WorkforceComplianceStatus   @default(PENDING)
  availabilityStatus  WorkforceAvailabilityStatus @default(AVAILABLE)
  primaryDepartmentId String?                     @db.Uuid
  primaryPositionId   String?                     @db.Uuid
  homeZoneId          String?                     @db.Uuid
  skills              Json?
  metadata            Json?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  deletedAt           DateTime?
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee            Employee?                   @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user                User?                       @relation("WorkforceMemberUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  primaryDepartment   Department?                 @relation(fields: [primaryDepartmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  primaryPosition     Position?                   @relation(fields: [primaryPositionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  homeZone            OperationalZone?            @relation("WorkforceMemberHomeZone", fields: [homeZoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  profileExtension    WorkforceProfileExtension?
  authorizations      WorkforceAuthorization[]
  credentialDocuments CredentialDocument[]
  statusHistory       WorkforceStatusHistory[]
  assignments         ResourceAssignment[]
  maintenanceRecords  AssetMaintenanceRecord[]
  incidents           OperationalIncident[]

  @@unique([organizationId, workerCode])
  @@index([organizationId, workerType, operationalStatus])
  @@index([organizationId, availabilityStatus, complianceStatus])
  @@index([primaryDepartmentId])
  @@index([primaryPositionId])
  @@index([homeZoneId])
  @@index([deletedAt])
  @@map("workforce_members")
}

model CredentialDocument {
