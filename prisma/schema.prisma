model ActionExecution {
  id                String                @id @default(uuid()) @db.Uuid
  proposalId        String?               @db.Uuid
  organizationId    String                @db.Uuid
  type              ActionExecutionType
  status            ActionExecutionStatus @default(PENDING)
  approvalStatus    ActionApprovalStatus  @default(PENDING)
  requestedByUserId String?               @db.Uuid
  approvedByUserId  String?               @db.Uuid
  executedAt        DateTime?
  result            Json?
  error             String?               @db.VarChar(1000)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  proposal          ActionProposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedByUser   User?                 @relation("ActionExecutionRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser    User?                 @relation("ActionExecutionApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditTrail        ActionExecutionAudit[]
  outcome           ActionOutcome?

  @@index([organizationId])
  @@index([proposalId])
  @@index([status])
  @@index([type])
  @@map("action_executions")
}

model StrategicPlan {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  createdByUserId String?                 @db.Uuid
  title           String                  @db.VarChar(255)
  planningWindow  StrategicPlanningWindow
  status          StrategicPlanStatus     @default(DRAFT)
  summary         String?                 @db.VarChar(2000)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser   User?                   @relation("StrategicPlanCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  priorities      StrategicPriority[]
  reviewReports   StrategicReviewReport[]

  @@index([organizationId])
  @@index([organizationId, planningWindow])
  @@index([status])
  @@map("strategic_plans")
}

model StrategicPriority {
  id                    String                    @id @default(uuid()) @db.Uuid
  strategicPlanId       String                    @db.Uuid
  title                 String                    @db.VarChar(255)
  description           String                    @db.VarChar(2000)
  category              StrategicPriorityCategory
  status                StrategicPriorityStatus   @default(IDENTIFIED)
  urgency               StrategicPriorityUrgency  @default(MEDIUM)
  linkedSignals         Json?
  linkedRecommendations Json?
  linkedProposals       Json?
  linkedScenarios       Json?
  linkedExecutions      Json?
  linkedAgentRuns       Json?
  linkedOutcomeSummary  Json?
  successCriteria       Json?
  owner                 String?                   @db.VarChar(255)
  targetDate            DateTime?
  notes                 String?                   @db.VarChar(2000)
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  strategicPlan         StrategicPlan             @relation(fields: [strategicPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([strategicPlanId])
  @@index([category])
  @@index([status])
  @@index([urgency])
  @@map("strategic_priorities")
}

model StrategicReviewReport {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  strategicPlanId  String?               @db.Uuid
  reviewWindow     StrategicReviewWindow
  windowStart      DateTime
  windowEnd        DateTime
  summary          String?               @db.VarChar(2000)
  trustSnapshot    Json?
  priorityProgress Json?
  signalChanges    Json?
  actionReview     Json?
  outcomeReview    Json?
  scenarioNotes    Json?
  executiveFocus   Json?
  limitations      Json?
  metadata         Json?
  generatedAt      DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  strategicPlan    StrategicPlan?        @relation(fields: [strategicPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, reviewWindow, generatedAt])
  @@index([strategicPlanId, generatedAt])
  @@map("strategic_review_reports")
}

model ActionExecutionAudit {
  id                String          @id @default(uuid()) @db.Uuid
  executionId       String          @db.Uuid
  organizationId    String          @db.Uuid
  action            String          @db.VarChar(100)
  actorUserId       String?         @db.Uuid
  previousStatus    String?         @db.VarChar(40)
  newStatus         String?         @db.VarChar(40)
  metadata          Json?
  createdAt          DateTime          @default(now())
  execution         ActionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([executionId])

  @@index([organizationId, createdAt])
  @@map("action_execution_audit")
}

model AiOnboardingStatus {
  id                        String             @id @default(uuid()) @db.Uuid
  organizationId            String             @unique @db.Uuid
  currentStep               AiOnboardingStep   @default(CONNECT_STORE)
  stepsCompleted            AiOnboardingStep[]
  shopifyConnected          Boolean            @default(false)
  stripeConnected           Boolean            @default(false)
  shopifyFirstSyncCompleted Boolean            @default(false)
  stripeFirstSyncCompleted  Boolean            @default(false)
  onboardingCompleted       Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@map("ai_onboarding_statuses")
}

model AiOnboardingAudit {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  step           AiOnboardingStep
  action         String           @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_onboarding_audit")
}

