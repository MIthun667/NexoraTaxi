FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN cd apps/web && NEXT_DIST_DIR=.next-build next build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile
COPY --from=build /app/apps/web ./apps/web
EXPOSE 3001
CMD ["sh", "-lc", "cd apps/web && NEXT_DIST_DIR=.next-build next start -H 0.0.0.0 -p 3001"]
