{
  "name": "nexora-company-os",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora universal AI Company OS platform foundation",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bash ./scripts/dev-local.sh",
    "dev:stop": "bash ./scripts/dev-stop.sh",
    "dev:setup": "pnpm dev:stop && pnpm prisma generate && npx prisma migrate deploy && npx prisma db push && pnpm db:seed && pnpm db:standardize-passwords",
    "dev:deps:up": "docker compose -f deploy/compose/development.yml up -d postgres redis",
    "dev:deps:down": "docker compose -f deploy/compose/development.yml stop postgres redis ollama",
    "dev:ai:up": "docker compose -f deploy/compose/development.yml up -d ollama",
    "api:dev": "pnpm build && pnpm start",
    "build": "rm -rf dist/apps/api && tsc -p apps/api/tsconfig.app.json --incremental false",
    "start": "node dist/apps/api/main.js",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "web:clean": "cd apps/web && rm -rf .next .next-build",
    "web:dev": "cd apps/web && next dev -H 127.0.0.1 -p 3001",
    "web:dev:reset": "npm run web:clean && npm run web:dev",
    "web:build": "cd apps/web && rm -rf .next-build && NEXT_DIST_DIR=.next-build next build",
    "web:start": "cd apps/web && NEXT_DIST_DIR=.next-build next start -H 127.0.0.1 -p 3001",
    "docker:dev:up": "docker compose -f deploy/compose/development.yml up --build",
    "docker:dev:init": "docker compose -f deploy/compose/development.yml --profile tools run --rm seed",
    "docker:dev:down": "docker compose -f deploy/compose/development.yml down -v",
    "lint": "eslint \"{apps,prisma}/**/*.ts\"",
    "format": "prettier --write \"{apps,prisma}/**/*.{ts,js,json}\"",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "typecheck:seed": "tsc -p tsconfig.seed.json",
    "db:seed": "prisma db seed",
    "db:standardize-passwords": "npx ts-node --transpile-only scripts/dev/tools/standardize-dev-password.ts",
    "db:backfill-universal": "npx ts-node --transpile-only scripts/migrations/manual/backfill-universal-operational-layer.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --test -r ts-node/register -r tsconfig-paths/register apps/api/test/security/*.unit.test.ts",
    "test:integration": "node --test -r ts-node/register -r tsconfig-paths/register apps/api/test/security/*.integration.test.ts",
    "test:ci": "pnpm test"
  },
  "prisma": {
    "seed": "node prisma/seed-runner.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-query": "^5.66.8",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "joi": "^17.13.3",
    "lucide-react": "^0.511.0",
    "next": "^15.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
