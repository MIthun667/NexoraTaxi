NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Nexora Platform API
APP_VERSION=0.1.0

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nexora_taxi?schema=public
REDIS_URL=redis://127.0.0.1:6379
JOB_QUEUE_PREFIX=nexora
JOB_DEFAULT_ATTEMPTS=3
JOB_BACKOFF_MS=1000
WORKER_CONCURRENCY=5

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
JWT_REFRESH_EXPIRES=7d
ENCRYPTION_KEY=replace-with-at-least-32-characters

# Development only. This variable is forbidden when NODE_ENV=production.
DEV_AUTH_USER_EMAIL=admin@northstar-universal.demo

AUTH_RATE_LIMIT_LIMIT=10
AUTH_RATE_LIMIT_TTL=60
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false

SHOPIFY_API_KEY=replace-me
SHOPIFY_API_SECRET=replace-me
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_REDIRECT_URI=http://localhost:3001/api/v1/integrations/shopify/callback
SHOPIFY_APP_URL=http://localhost:3001
SHOPIFY_API_VERSION=2026-01
SHOPIFY_WEBHOOK_BASE_URL=http://localhost:3001

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HEALTHCHECK_ENABLED=false
OLLAMA_MAX_RETRIES=2
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=15000

STRIPE_API_BASE_URL=https://api.stripe.com/v1
